# Copy to .env for local development; never commit real secrets.
SPESEN_DATA_DIR=./data-dev
SPESEN_LISTEN=:8080
SPESEN_BASE_URL=http://localhost:8080
SPESEN_SETUP_TOKEN=change-me
SPESEN_PASSWORD_LOGIN=true
SPESEN_TYPST=typst
